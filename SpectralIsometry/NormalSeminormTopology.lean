module
public import SpectralIsometry.NormalSeminormStructure
public import SpectralIsometry.GenericNormalProjectionConverse

/-!
# Normal Seminorm Topology

Supporting results for spectral isometries of complex unital C*-algebras.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section
open Filter Topology
open scoped ComplexOrder

namespace SpectralIsometry.NormalSeminorm
open OAI.HochschildNormalPart NormalProjectionContinuity StrongStarApproximation
open OAI.BoundedHochschild.KadisonRingrose
open BidualFoundation.UniversalWeakClosure

universe u w
variable {M X : Type u} [CStarAlgebra M]
  [NormedAddCommGroup X] [NormedSpace ℂ X] [CompleteSpace X]
local instance topologyOrderedM : PartialOrder M := CStarAlgebra.spectralOrder M
local instance topologyStarOrderedM : StarOrderedRing M := CStarAlgebra.spectralOrderedRing M
local instance (priority := 2000) topologyComplexOrder : PartialOrder ℂ := Complex.partialOrder
local instance (priority := 2000) topologyComplexStarOrder : StarOrderedRing ℂ := RCLike.toStarOrderedRing
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 800000

def NormalPositiveIndex (e : StrongDual ℂ X ≃ₗᵢ⋆[ℂ] M) :=
  {ψ : M →ₚ[ℂ] ℂ // ∃ φ : StrongDual ℂ M, (∀ x : M, φ x=ψ x) ∧ φ∈normalDual e}

def normalFamily (e : StrongDual ℂ X ≃ₗᵢ⋆[ℂ] M) :
    SeminormFamily ℂ M (NormalPositiveIndex e) := fun i => bundled i.val

/-- The actual topology generated by every normal positive square-root
seminorm. The normality witness does not change its displayed value. -/
def strongStarTopology (e : StrongDual ℂ X ≃ₗᵢ⋆[ℂ] M) : TopologicalSpace M :=
  (normalFamily e).moduleFilterBasis.topology

theorem topology_withSeminorms (e : StrongDual ℂ X ≃ₗᵢ⋆[ℂ] M) :
    @WithSeminorms ℂ M (NormalPositiveIndex e) _ _ _ (normalFamily e)
      (strongStarTopology e) := by
  exact @WithSeminorms.mk ℂ M (NormalPositiveIndex e) _ _ _
    (normalFamily e) (strongStarTopology e) rfl

private theorem seminorm_tendsto_zero_iff (p : Seminorm ℂ M) {ι : Type w}
    {l : Filter ι} (a : ι → M) (b : M) :
    Tendsto (fun i => p (a i-b)) l (𝓝 0) ↔
      ∀ ε : ℝ, 0<ε → ∀ᶠ i in l, p (a i-b)<ε := by
  rw [Metric.tendsto_nhds]
  simp only [Real.dist_eq,sub_zero,abs_of_nonneg (apply_nonneg p _)]

theorem tendsto_topology_iff (e : StrongDual ℂ X ≃ₗᵢ⋆[ℂ] M)
    {ι : Type w} (a : ι → M) (l : Filter ι) (b : M) :
    Tendsto a l (@nhds M (strongStarTopology e) b) ↔ SeminormTendsto e a l b := by
  have hp := topology_withSeminorms e
  rw [@WithSeminorms.tendsto_nhds ℂ M ι (NormalPositiveIndex e)
    _ _ _ (strongStarTopology e) (normalFamily e) hp a l b]
  constructor
  · intro h ψ φ heq hn
    let i : NormalPositiveIndex e := ⟨ψ,⟨φ,heq,hn⟩⟩
    have hi : Tendsto (fun j => (normalFamily e i) (a j-b)) l (𝓝 0) :=
      (seminorm_tendsto_zero_iff (normalFamily e i) a b).mpr (h i)
    simpa only [normalFamily,bundled_apply] using hi
  · intro h i ε hε
    obtain ⟨φ,heq,hn⟩ := i.property
    have hi : Tendsto (fun j => (normalFamily e i) (a j-b)) l (𝓝 0) := by
      simpa only [normalFamily,bundled_apply] using h i.val φ heq hn
    exact (seminorm_tendsto_zero_iff (normalFamily e i) a b).mp hi ε hε

theorem tendsto_topology_iff_normalPositive (e : StrongDual ℂ X ≃ₗᵢ⋆[ℂ] M)
    {ι : Type w} (a : ι → M) (l : Filter ι) (b : M) :
    Tendsto a l (@nhds M (strongStarTopology e) b) ↔
      NormalPositiveStrongStarTendsto e a l b :=
  (tendsto_topology_iff e a l b).trans (seminormTendsto_iff e a l b)

theorem tendsto_topology_iff_normalCompression (e : StrongDual ℂ X ≃ₗᵢ⋆[ℂ] M)
    {ι : Type w} (a : ι → M) (l : Filter ι) (b : M) :
    Tendsto a l (@nhds M (strongStarTopology e) b) ↔
      StrongStarTendsto
        (fun i => normalProjection e (universalGNSRepresentation (M:=M)) *
          universalGNSRepresentation (a i)) l
        (normalProjection e (universalGNSRepresentation (M:=M)) *
          universalGNSRepresentation b) :=
  (tendsto_topology_iff_normalPositive e a l b).trans
    (normalPositive_iff_universal_compressed_strongStar e)

end SpectralIsometry.NormalSeminorm

